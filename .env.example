# ============================================
# সবুজ বই — Environment Configuration
# কপি করে .env বানান: cp .env.example .env
# ============================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key (দীর্ঘ random string দিন — production-এ)
# জেনারেট করার কমান্ড:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_long_random_string_in_production

# Admin Password
ADMIN_PASSWORD=kawsar2024

# Server
HOST=0.0.0.0
PORT=5000

# Session Lifetime (seconds) — default 24 hours
SESSION_LIFETIME=86400